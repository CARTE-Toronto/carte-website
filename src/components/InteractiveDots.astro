---
// Interactive dot grid background with cascading network activation.
// The dot field lives in page space (it scrolls with the content), but the
// canvas is only ever viewport-sized: each frame translates by scrollY and
// draws the dots that are in view. The frame loop runs only while something
// is changing (cursor activation fading, a scroll, the colour transition) and
// stops when the page is idle or hidden.
// Optionally shifts colours based on scroll position: light theme → dark theme.

interface Props {
  scrollColorTransition?: boolean;
}

const { scrollColorTransition = false } = Astro.props;
---

<div id="dots-container" class="fixed inset-0 -z-10 pointer-events-none overflow-hidden bg-pale-bg" data-scroll-transition={scrollColorTransition.toString()} aria-hidden="true">
  <canvas id="dots-canvas" class="block pointer-events-none"></canvas>
</div>

<script>
  const canvas = document.getElementById('dots-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const container = document.getElementById('dots-container')!;

  // Configuration
  const GRID_SIZE = 24;
  const DOT_RADIUS = 1.5;
  const ACTIVATION_RADIUS = 60; // pixels from cursor to directly activate dots
  const FADE_SPEED = 0.08; // how fast activation changes (lower = smoother)
  const MAX_CONNECTION_DISTANCE = GRID_SIZE * 3; // search for neighbours within 3 grid cells
  const MIN_CONNECTIONS = 2;
  const MAX_CONNECTIONS = 4;
  const MAX_HOPS = 4; // how many hops activation can spread
  const HOP_DECAY = 0.55; // opacity multiplier per hop
  const MAX_DPR = 2; // 3x backing stores triple the fill cost for no visible gain at 1.5px dots
  const CULL_MARGIN = MAX_CONNECTION_DISTANCE; // draw a little beyond the viewport so lines don't clip

  // Colour themes for the scroll-based transition (canvas needs RGB triples;
  // these mirror --surface-page / --brand-primary in carte-components.css)
  const LIGHT_BG = [253, 251, 247];
  const LIGHT_DOT = [30, 55, 101];
  const LIGHT_DOT_BASE_OPACITY = 0.06;
  const LIGHT_DOT_ACTIVE_OPACITY = 0.15;
  const LIGHT_LINE_MAX_OPACITY = 0.18;

  const DARK_BG = [30, 55, 101];
  const DARK_DOT = [253, 251, 247];
  const DARK_DOT_BASE_OPACITY = 0.12;
  const DARK_DOT_ACTIVE_OPACITY = 0.35;
  const DARK_LINE_MAX_OPACITY = 0.25;

  // Scroll transition config (mobile transitions sooner)
  const isMobile = window.innerWidth < 640;
  const TRANSITION_START = isMobile ? 0.55 : 0.75;
  const TRANSITION_END = isMobile ? 0.60 : 0.80;
  const SCROLL_TRANSITION_ENABLED = container.dataset.scrollTransition === 'true';

  interface Connection {
    neighborIdx: number;
    baseOpacity: number; // per-connection multiplier (0.6 – 1.0)
  }

  interface Dot {
    x: number;
    y: number; // page-space y
    connections: Connection[]; // outgoing ("forward") links
    incoming: Connection[]; // reverse index so BFS never scans the whole field
    currentActivation: number;
    targetActivation: number;
  }

  let dots: Dot[] = [];
  let cols = 0;
  let rows = 0;
  let viewportW = 0;
  let viewportH = 0;
  let dpr = 1;
  let scrollY = window.scrollY;
  let mouseX = -1000; // viewport space
  let mouseY = -1000;
  let currentScrollT = 0; // 0 = light, 1 = dark
  let animationId = 0;
  let running = false;
  let anyActivation = false;

  // Seeded random number generator for stable, repeatable connections
  function seededRandom(seed: number): () => number {
    return function () {
      seed = (seed * 1103515245 + 12345) & 0x7fffffff;
      return seed / 0x7fffffff;
    };
  }

  function getDistance(x1: number, y1: number, x2: number, y2: number): number {
    return Math.sqrt((x2 - x1) ** 2 + (y2 - y1) ** 2);
  }

  function documentHeight(): number {
    return Math.max(document.documentElement.scrollHeight, document.body.scrollHeight, window.innerHeight);
  }

  // Build the dot field over the whole document (positions only; cheap even
  // for very long pages), with 2–4 seeded forward connections per dot.
  function generateDots(width: number, height: number) {
    dots = [];
    cols = Math.ceil(width / GRID_SIZE) + 1;
    rows = Math.ceil(height / GRID_SIZE) + 1;

    for (let row = 0; row < rows; row++) {
      for (let col = 0; col < cols; col++) {
        dots.push({ x: col * GRID_SIZE, y: row * GRID_SIZE, connections: [], incoming: [], currentActivation: 0, targetActivation: 0 });
      }
    }

    for (let i = 0; i < dots.length; i++) {
      const dot = dots[i];
      const col = i % cols;
      const row = Math.floor(i / cols);
      const rand = seededRandom(col * 10000 + row * 100 + 42);

      const potential: number[] = [];
      for (let dr = 0; dr <= 3; dr++) {
        for (let dc = -2; dc <= 3; dc++) {
          if (dr === 0 && dc <= 0) continue; // only "forward" so each line exists once
          const nc = col + dc;
          const nr = row + dr;
          if (nc < 0 || nc >= cols || nr < 0 || nr >= rows) continue;
          const j = nr * cols + nc;
          if (j >= dots.length || j === i) continue;
          const dist = getDistance(dot.x, dot.y, dots[j].x, dots[j].y);
          if (dist > 0 && dist <= MAX_CONNECTION_DISTANCE) potential.push(j);
        }
      }

      for (let j = potential.length - 1; j > 0; j--) {
        const k = Math.floor(rand() * (j + 1));
        [potential[j], potential[k]] = [potential[k], potential[j]];
      }

      const count = MIN_CONNECTIONS + Math.floor(rand() * (MAX_CONNECTIONS - MIN_CONNECTIONS + 1));
      for (const j of potential.slice(0, count)) {
        const baseOpacity = 0.6 + rand() * 0.4;
        dot.connections.push({ neighborIdx: j, baseOpacity });
        dots[j].incoming.push({ neighborIdx: i, baseOpacity });
      }
    }
  }

  // Spread activation from the cursor through the network (BFS, both directions).
  function calculateActivations(px: number, py: number) {
    anyActivation = false;
    for (const dot of dots) dot.targetActivation = 0;
    if (px < -500 || py < -500) return;

    const visited = new Map<number, number>(); // dot index → hop count
    const queue: { idx: number; hops: number }[] = [];

    // Seeds: only rows near the cursor can be within ACTIVATION_RADIUS
    const rowFrom = Math.max(0, Math.floor((py - ACTIVATION_RADIUS) / GRID_SIZE));
    const rowTo = Math.min(rows - 1, Math.ceil((py + ACTIVATION_RADIUS) / GRID_SIZE));
    for (let row = rowFrom; row <= rowTo; row++) {
      for (let col = 0; col < cols; col++) {
        const i = row * cols + col;
        const dist = getDistance(dots[i].x, dots[i].y, px, py);
        if (dist < ACTIVATION_RADIUS) {
          dots[i].targetActivation = Math.pow(1 - dist / ACTIVATION_RADIUS, 1.5);
          visited.set(i, 0);
          queue.push({ idx: i, hops: 0 });
          anyActivation = true;
        }
      }
    }

    let head = 0;
    while (head < queue.length) {
      const { idx, hops } = queue[head++];
      if (hops >= MAX_HOPS) continue;
      const parent = dots[idx].targetActivation;
      const spread = (conn: Connection) => {
        const j = conn.neighborIdx;
        const seen = visited.get(j);
        if (seen !== undefined && seen <= hops + 1) return;
        visited.set(j, hops + 1);
        const v = parent * HOP_DECAY * conn.baseOpacity;
        if (v > dots[j].targetActivation) dots[j].targetActivation = v;
        if (v > 0.01) queue.push({ idx: j, hops: hops + 1 });
      };
      for (const c of dots[idx].connections) spread(c);
      for (const c of dots[idx].incoming) spread(c);
    }
  }

  function lerp(a: number, b: number, t: number): number {
    return a + (b - a) * t;
  }

  function getScrollT(): number {
    if (!SCROLL_TRANSITION_ENABLED) return 0;
    const range = documentHeight() - window.innerHeight;
    if (range <= 0) return 0;
    const p = scrollY / range;
    if (p <= TRANSITION_START) return 0;
    if (p >= TRANSITION_END) return 1;
    return (p - TRANSITION_START) / (TRANSITION_END - TRANSITION_START);
  }

  function mix(a: number[], b: number[], t: number): number[] {
    return [Math.round(lerp(a[0], b[0], t)), Math.round(lerp(a[1], b[1], t)), Math.round(lerp(a[2], b[2], t))];
  }

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR);
    viewportW = window.innerWidth;
    viewportH = window.innerHeight;
    canvas.width = viewportW * dpr;
    canvas.height = viewportH * dpr;
    canvas.style.width = `${viewportW}px`;
    canvas.style.height = `${viewportH}px`;
    generateDots(viewportW, documentHeight());
    kick();
  }

  function draw() {
    // Ease the colour transition toward the scroll target
    const targetT = getScrollT();
    const dT = targetT - currentScrollT;
    currentScrollT = Math.abs(dT) < 0.002 ? targetT : currentScrollT + dT * 0.1;

    const bg = mix(LIGHT_BG, DARK_BG, currentScrollT);
    const dotColor = mix(LIGHT_DOT, DARK_DOT, currentScrollT);
    const baseOpacity = lerp(LIGHT_DOT_BASE_OPACITY, DARK_DOT_BASE_OPACITY, currentScrollT);
    const activeOpacity = lerp(LIGHT_DOT_ACTIVE_OPACITY, DARK_DOT_ACTIVE_OPACITY, currentScrollT);
    const lineMax = lerp(LIGHT_LINE_MAX_OPACITY, DARK_LINE_MAX_OPACITY, currentScrollT);
    container.style.backgroundColor = `rgb(${bg[0]}, ${bg[1]}, ${bg[2]})`;

    // Page-space drawing on a viewport-sized canvas
    ctx.setTransform(dpr, 0, 0, dpr, 0, -scrollY * dpr);
    ctx.clearRect(0, scrollY, viewportW, viewportH);

    calculateActivations(mouseX, mouseY + scrollY);

    let stillFading = false;
    const top = scrollY - CULL_MARGIN;
    const bottom = scrollY + viewportH + CULL_MARGIN;
    const rowFrom = Math.max(0, Math.floor(top / GRID_SIZE));
    const rowTo = Math.min(rows - 1, Math.ceil(bottom / GRID_SIZE));

    for (const dot of dots) {
      const before = dot.currentActivation;
      dot.currentActivation += (dot.targetActivation - dot.currentActivation) * FADE_SPEED;
      if (dot.currentActivation < 0.001) dot.currentActivation = 0;
      if (dot.currentActivation !== before) stillFading = true;
    }

    const rgb = `${dotColor[0]}, ${dotColor[1]}, ${dotColor[2]}`;
    ctx.lineWidth = 0.5;
    for (let row = rowFrom; row <= rowTo; row++) {
      for (let col = 0; col < cols; col++) {
        const dot = dots[row * cols + col];
        for (const conn of dot.connections) {
          const n = dots[conn.neighborIdx];
          const s = Math.min(dot.currentActivation, n.currentActivation);
          if (s > 0.001) {
            ctx.beginPath();
            ctx.moveTo(dot.x, dot.y);
            ctx.lineTo(n.x, n.y);
            ctx.strokeStyle = `rgba(${rgb}, ${s * lineMax * conn.baseOpacity})`;
            ctx.stroke();
          }
        }
      }
    }

    for (let row = rowFrom; row <= rowTo; row++) {
      for (let col = 0; col < cols; col++) {
        const dot = dots[row * cols + col];
        ctx.beginPath();
        ctx.arc(dot.x, dot.y, DOT_RADIUS, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${rgb}, ${baseOpacity + (activeOpacity - baseOpacity) * dot.currentActivation})`;
        ctx.fill();
      }
    }

    // Keep animating only while something is still changing
    if (anyActivation || stillFading || currentScrollT !== targetT) {
      animationId = requestAnimationFrame(draw);
    } else {
      running = false;
    }
  }

  function kick() {
    if (running || document.hidden) return;
    running = true;
    animationId = requestAnimationFrame(draw);
  }

  function handleMouseMove(e: MouseEvent) {
    mouseX = e.clientX;
    mouseY = e.clientY;
    kick();
  }

  function handleMouseLeave() {
    mouseX = -1000;
    mouseY = -1000;
    kick();
  }

  function handleScroll() {
    scrollY = window.scrollY;
    kick();
  }

  function handleVisibility() {
    if (document.hidden) {
      cancelAnimationFrame(animationId);
      running = false;
    } else {
      kick();
    }
  }

  function init() {
    document.addEventListener('mousemove', handleMouseMove, { passive: true });
    document.addEventListener('mouseleave', handleMouseLeave);
    window.addEventListener('scroll', handleScroll, { passive: true });
    window.addEventListener('resize', resize);
    document.addEventListener('visibilitychange', handleVisibility);

    // Regenerate the field when content changes the page height
    let pending = 0;
    const observer = new ResizeObserver(() => {
      cancelAnimationFrame(pending);
      pending = requestAnimationFrame(resize);
    });
    observer.observe(document.body);

    resize();
  }

  document.addEventListener('astro:before-swap', () => {
    cancelAnimationFrame(animationId);
    document.removeEventListener('mousemove', handleMouseMove);
    document.removeEventListener('mouseleave', handleMouseLeave);
    window.removeEventListener('scroll', handleScroll);
    window.removeEventListener('resize', resize);
    document.removeEventListener('visibilitychange', handleVisibility);
  });

  init();
</script>
