---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'on-dark' | 'on-dark-ghost';
  class?: string;
}

const { href, variant = 'primary', class: className } = Astro.props;

const cls = {
  primary:         'carte-btn-primary',
  ghost:           'carte-btn-ghost',
  'on-dark':       'inv-btn primary',
  'on-dark-ghost': 'inv-btn ghost',
}[variant];
---

<a href={href} class:list={[cls, className]}>
  <slot />
</a>
