---
interface Props {
  title?: string;
  subtitle?: string;
  background?: 'white' | 'gray';
  tint?: 'none' | 'warm' | 'white' | 'blue-light' | 'blue-dark';
  class?: string;
}

const { title, subtitle, background = 'white', tint = 'none', class: className } = Astro.props;

const bgClass = background === 'gray' ? 'bg-cool-gray' : '';

const tintStyles: Record<string, string> = {
  'none': '',
  'warm': 'rgba(253, 251, 247, 0.7)',
  'white': 'rgba(255, 255, 255, 0.5)',
  'blue-light': 'rgba(0, 120, 148, 0.05)',
  'blue-dark': 'rgba(30, 55, 101, 0.88)',
};

const tintColor = tintStyles[tint] || '';
---

<section class={`relative ${bgClass} py-20 lg:py-28 ${className}`}>
  {tint !== 'none' && tintColor && (
    <div
      class="absolute inset-0 pointer-events-none"
      style={`background: ${tintColor};`}
    />
  )}
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {(title || subtitle) && (
      <div class="text-center mb-12">
        {title && <h2 class="text-3xl font-extrabold sm:text-4xl" style="color:var(--text-strong)">{title}</h2>}
        {subtitle && <p class="mt-4 max-w-2xl text-xl mx-auto font-normal" style="color:var(--text-muted)">{subtitle}</p>}
      </div>
    )}
    <slot />
  </div>
</section>
