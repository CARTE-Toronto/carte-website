---
interface Props {
  title: string;
  description?: string;
  href: string;
  date?: Date;
  tag?: string;
}

const { title, description, href, date, tag } = Astro.props;
---

<a href={href} class="block h-full">
  <div class="carte-card card-demo h-full flex flex-col">
    {tag && <span class="tag">{tag}</span>}
    <h3>{title}</h3>
    {date && (
      <p style="font: 500 13px var(--font-mono); color: var(--text-subtle); margin: 0 0 8px;">
        {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
    )}
    {description && <p class="flex-grow">{description}</p>}
    <span class="link-arrow mt-auto">Read more →</span>
  </div>
</a>
