---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
---

<BaseLayout title="Home" scrollColorTransition={true}>
  <Hero />

  <!-- Student & Faculty Callouts -->
  <section class="py-8 bg-[#E6F5F3]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-center text-sm text-slate-500 mb-4">Part of the U of T community?</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <div
          class="inline-flex items-center gap-2 px-6 py-3 bg-white border-2 border-[#00A189] rounded-full shadow-sm hover:shadow-md transition-all hover:scale-105"
        >
          <span class="text-[#0D534D] font-semibold">U of T Student?</span>
          <a
            href="/students"
            class="text-[#0D534D] font-bold hover:text-[#0D534D] underline"
          >
            Explore student opportunities
          </a>
        </div>
        <div
          class="inline-flex items-center gap-2 px-6 py-3 bg-white border-2 border-[#007894] rounded-full shadow-sm hover:shadow-md transition-all hover:scale-105"
        >
          <span class="text-[#007894] font-semibold">U of T Faculty?</span>
          <a
            href="/faculty"
            class="text-[#007894] font-bold hover:text-[#1E3765] underline"
          >
            Access faculty resources
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Approach Section - Positioning/Differentiation -->
  <section class="py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2
          class="text-3xl sm:text-4xl font-extrabold text-[var(--color-uoft-blue)] mb-6"
        >
          How We Work Together
        </h2>
        <p class="text-lg text-slate-600 leading-relaxed">
          Carte connects industry partners with University of Toronto Engineering 
          faculty and students working on applied AI across diverse fields.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        <a
          href="/partnerships"
          class="bg-white rounded-2xl p-6 border border-slate-200 hover:border-[var(--color-uoft-accent)] hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 group flex flex-col"
        >
          <div
            class="w-12 h-12 rounded-xl bg-[#EEF2F8] flex items-center justify-center mb-4"
          >
            <svg
              class="w-6 h-6 text-[var(--color-uoft-blue)]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
              ></path>
            </svg>
          </div>
          <h3 class="font-bold text-[var(--color-uoft-blue)] mb-2">
            Strategic Research Partnerships
          </h3>
          <p class="text-sm text-slate-600 mb-3 flex-grow">
            Work with a network of 100+ faculty across U of T Engineering 
            to address complex interdisciplinary AI challenges.
          </p>
          <span
            class="text-sm font-medium text-[var(--color-uoft-blue)] group-hover:underline mt-auto"
            >Partner with us &rarr;</span
          >
        </a>

        <a
          href="/training"
          class="bg-white rounded-2xl p-6 border border-slate-200 hover:border-[var(--color-uoft-accent)] hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 group flex flex-col"
        >
          <div
            class="w-12 h-12 rounded-xl bg-[#FFF8E1] flex items-center justify-center mb-4"
          >
            <svg
              class="w-6 h-6 text-[#D4A800]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              ></path>
            </svg>
          </div>
          <h3 class="font-bold text-[var(--color-uoft-blue)] mb-2">
            Custom Training
          </h3>
          <p class="text-sm text-slate-600 mb-3 flex-grow">
            Industry-focused AI training tailored to your team's needs and
            technical level.
          </p>
          <span
            class="text-sm font-medium text-[var(--color-uoft-blue)] group-hover:underline mt-auto"
            >Explore programs &rarr;</span
          >
        </a>

        <a
          href="/partnerships"
          class="bg-white rounded-2xl p-6 border border-slate-200 hover:border-[var(--color-uoft-accent)] hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 group flex flex-col"
        >
          <div
            class="w-12 h-12 rounded-xl bg-[#E6F5F3] flex items-center justify-center mb-4"
          >
            <svg
              class="w-6 h-6 text-[#00A189]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
          </div>
          <h3 class="font-bold text-[var(--color-uoft-blue)] mb-2">
            Funding Support
          </h3>
          <p class="text-sm text-slate-600 mb-3 flex-grow">
            Programs like Mitacs fund AI initiatives in industry and academia.
            We support you from application through project delivery.
          </p>
          <span
            class="text-sm font-medium text-[var(--color-uoft-blue)] group-hover:underline mt-auto"
            >Explore funding options &rarr;</span
          >
        </a>

        <a
          href="/partnerships"
          class="bg-white rounded-2xl p-6 border border-slate-200 hover:border-[var(--color-uoft-accent)] hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 group flex flex-col"
        >
          <div
            class="w-12 h-12 rounded-xl bg-[#F3E8F5] flex items-center justify-center mb-4"
          >
            <svg
              class="w-6 h-6 text-[#6D247A]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
              ></path>
            </svg>
          </div>
          <h3 class="font-bold text-[var(--color-uoft-blue)] mb-2">
            Talent Pipeline
          </h3>
          <p class="text-sm text-slate-600 mb-3 flex-grow">
            Capstone projects, internships, and direct access to top engineering
            students.
          </p>
          <span
            class="text-sm font-medium text-[var(--color-uoft-blue)] group-hover:underline mt-auto"
            >Hire students &rarr;</span
          >
        </a>
      </div>
    </div>
  </section>

  <!-- Impact / By the Numbers Section -->
  <section class="py-20 lg:py-28 relative">
    <div class="absolute inset-0 bg-[var(--color-uoft-dark)]"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">
          Impact Across Sectors
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Professionals Trained -->
        <div class="text-center">
          <div class="text-5xl lg:text-6xl font-extrabold text-white mb-2">
            150+
          </div>
          <div class="text-white/80 font-medium mb-2">
            Professionals Trained
          </div>
          <p class="text-sm text-white/60">
            Through multi-day AI training for faculty, researchers, and industry
          </p>
        </div>

        <!-- Sectors -->
        <div class="text-center">
          <div class="text-5xl lg:text-6xl font-extrabold text-white mb-2">
            5+
          </div>
          <div class="text-white/80 font-medium mb-2">Sectors Served</div>
          <p class="text-sm text-white/60">
            Manufacturing, finance, energy, healthcare, and public sector
          </p>
        </div>

        <!-- Student Community -->
        <div class="text-center">
          <div class="text-5xl lg:text-6xl font-extrabold text-white mb-2">
            1,000+
          </div>
          <div class="text-white/80 font-medium mb-2">Student Community</div>
          <p class="text-sm text-white/60">
            Connected through workshops, capstone projects, and networking events
          </p>
        </div>

        <!-- Applied Projects -->
        <div class="text-center">
          <div class="text-5xl lg:text-6xl font-extrabold text-white mb-2">
            30+
          </div>
          <div class="text-white/80 font-medium mb-2">
            Applied AI Projects
          </div>
          <p class="text-sm text-white/60">
            MEng capstones tackling real challenges from LLMs to climate-health
          </p>
        </div>
      </div>

      <!-- Highlight callout -->
      <div
        class="mt-16 bg-white/10 backdrop-blur-sm rounded-2xl p-8 border border-white/20"
      >
        <div
          class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6"
        >
          <div>
            <p class="text-white font-medium text-lg mb-2">
              From genomic ML for healthcare institutions to LLM workshops for engineering teams — our training programs are built around your field.
            </p>
            <p class="text-white/70 text-sm">
              Average participant satisfaction: <span
                class="text-white font-bold">4.8/5</span
              >
            </p>
          </div>
          <a
            href="/training"
            class="flex-shrink-0 inline-flex items-center justify-center px-6 py-3 rounded-full bg-white text-[var(--color-uoft-blue)] font-bold hover:bg-blue-50 hover:shadow-md transition-all duration-200"
          >
            Explore Training
            <svg
              class="ml-2 w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
