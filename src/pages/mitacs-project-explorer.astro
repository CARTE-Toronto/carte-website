---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mitacs Project Explorer" description="Explore Mitacs projects at Carte - the Centre for Analytics and Artificial Intelligence Engineering at the University of Toronto.">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-10">
    <h1 class="carte-h1 mb-3">Mitacs Project Explorer</h1>
    <p class="text-lg text-muted max-w-3xl">
      Browse available projects from UofT faculty members and find opportunities that match your interests and skills.
    </p>
  </section>

  <!-- Full-width iframe embed section -->
  <section class="w-full px-4 sm:px-6 lg:px-8 py-6 sm:py-8 h-[calc(100vh-6rem)] min-h-[40rem]">
    <div class="w-full h-full rounded-lg overflow-hidden">
      <iframe
        src="https://cartetoronto.retool.com/embedded/public/97edc505-b245-48c7-88e3-bce3c888b24a"
        width="100%"
        height="100%"
        style="border: 0;"
        title="Mitacs Project Explorer"
        loading="lazy"
      ></iframe>
    </div>
  </section>
</BaseLayout>
