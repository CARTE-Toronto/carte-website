---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with Carte - send us an email or visit us at the Myhal Centre.">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24">
      <div class="max-w-3xl">
        <h1 class="carte-h1 mb-6">
          Get in touch
        </h1>
        <p class="text-xl text-muted leading-relaxed">
          Interested in collaborating with Carte? Send us an email.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
        
        <!-- Left Column: Contact Info -->
        <div>
          <h2 class="carte-h2 mb-8">Contact information</h2>
          
          <div class="space-y-8">
            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0" style="background:var(--surface-info)">
                <svg class="w-6 h-6 text-secondary-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-uoft-blue mb-1">Email</h3>
                <a href="mailto:carte@utoronto.ca" class="text-secondary-blue hover:text-secondary-blue-dark transition-colors text-lg">
                  carte@utoronto.ca
                </a>
              </div>
            </div>
            
            <!-- Location -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0" style="background:var(--surface-info)">
                <svg class="w-6 h-6 text-secondary-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-uoft-blue mb-1">Location</h3>
                <p class="text-muted">
                  Myhal Centre for Engineering Innovation & Entrepreneurship<br/>
                  55 St George Street<br/>
                  Toronto, ON M5S 0C9
                </p>
              </div>
            </div>
            
            <!-- Social -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0" style="background:var(--surface-info)">
                <svg class="w-6 h-6 text-secondary-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-uoft-blue mb-2">Follow us</h3>
                <div class="flex items-center gap-4">
                  <a href="https://www.linkedin.com/company/carte-toronto/" target="_blank" rel="noopener noreferrer" class="text-subtle hover:text-secondary-blue transition-colors" aria-label="LinkedIn">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                  </a>
                  <a href="https://www.instagram.com/carte_uoft/" target="_blank" rel="noopener noreferrer" class="text-subtle hover:text-secondary-blue transition-colors" aria-label="Instagram">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                  </a>
                  <a href="https://www.youtube.com/channel/UC9mYr0Ru6hAeajusllYVC4g" target="_blank" rel="noopener noreferrer" class="text-subtle hover:text-secondary-blue transition-colors" aria-label="YouTube">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Right Column: Collapsible Actions -->
        <div class="space-y-4">
          <!-- Book a Meeting (temporarily disabled)
          <details class="group bg-white rounded-2xl border border-slate-200 overflow-hidden">
            <summary class="bg-uoft-blue px-6 py-5 cursor-pointer list-none select-none">
              <div class="flex items-center justify-between">
                <div>
                  <h2 class="text-xl font-bold text-white flex items-center gap-3">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    Book an Exploratory Meeting
                  </h2>
                  <p class="text-slate-100 text-sm mt-1">Schedule a 30-minute call to discuss how Carte can help</p>
                </div>
                <svg class="w-6 h-6 text-white transition-transform duration-300 group-open:rotate-180 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </div>
            </summary>
            <div class="p-0">
              <iframe
                src="https://outlook.office.com/book/Carte1@utoronto.onmicrosoft.com/?ismsaljsauthenabled"
                width="100%"
                height="520"
                scrolling="yes"
                style="border:0"
                title="Book a meeting with Carte"
              ></iframe>
            </div>
          </details>
          -->
          
          <!-- Newsletter Signup -->
          <details class="group bg-white rounded-2xl border border-slate-200 overflow-hidden">
            <summary class="px-6 py-5 cursor-pointer list-none select-none" style="background:var(--brand-primary)">
              <div class="flex items-center justify-between">
                <div>
                  <h2 class="text-xl font-bold text-white flex items-center gap-3">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    Subscribe to newsletter
                  </h2>
                  <p class="text-slate-100 text-sm mt-1">Stay updated on AI research, training, and events</p>
                </div>
                <svg class="w-6 h-6 text-white transition-transform duration-300 group-open:rotate-180 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </div>
            </summary>
            <div class="p-6">
              <p class="text-muted mb-6">
                Get occasional updates about AI research, upcoming training opportunities, and events at Carte.
              </p>
              <form id="contact-subscribe-form" class="space-y-4">
                <!-- Email -->
                <div>
                  <label for="contact-email" class="carte-label">
                    Email Address <span style="color:#c0382a">*</span>
                  </label>
                  <input
                    type="email"
                    name="email"
                    id="contact-email"
                    placeholder="you@example.com"
                    class="carte-input"
                    required
                  />
                </div>

                <!-- Name Row -->
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label for="contact-first-name" class="carte-label">First Name</label>
                    <input
                      type="text"
                      name="first_name"
                      id="contact-first-name"
                      class="carte-input"
                    />
                  </div>
                  <div>
                    <label for="contact-last-name" class="carte-label">Last Name</label>
                    <input
                      type="text"
                      name="last_name"
                      id="contact-last-name"
                      class="carte-input"
                    />
                  </div>
                </div>

                <!-- Organization -->
                <div>
                  <label for="contact-organization" class="carte-label">Organization (if not UofT)</label>
                  <input
                    type="text"
                    name="organization"
                    id="contact-organization"
                    class="carte-input"
                  />
                </div>

                <!-- Academic Unit -->
                <div>
                  <label for="contact-academic-unit" class="carte-label">Academic Unit (if UofT)</label>
                  <select
                    name="academic_unit"
                    id="contact-academic-unit"
                    class="carte-select"
                  >
                    <option value="">Select...</option>
                    <option value="Applied Science &amp; Engineering">Applied Science & Engineering</option>
                    <option value="Architecture, Landscape &amp; Design">Architecture, Landscape & Design</option>
                    <option value="Arts &amp; Science">Arts & Science</option>
                    <option value="Continuing Studies">Continuing Studies</option>
                    <option value="Dentistry">Dentistry</option>
                    <option value="Education">Education</option>
                    <option value="Information">Information</option>
                    <option value="Kinesiology &amp; Physical Education">Kinesiology & Physical Education</option>
                    <option value="Law">Law</option>
                    <option value="Management">Management</option>
                    <option value="Medicine">Medicine</option>
                    <option value="Music">Music</option>
                    <option value="Nursing">Nursing</option>
                    <option value="Pharmacy">Pharmacy</option>
                    <option value="Public Health">Public Health</option>
                    <option value="Social Work">Social Work</option>
                    <option value="University of Toronto Mississauga">University of Toronto Mississauga</option>
                    <option value="University of Toronto Scarborough">University of Toronto Scarborough</option>
                    <option value="Other">Other</option>
                  </select>
                </div>

                <!-- Affiliation Type -->
                <fieldset>
                  <legend class="carte-label">Affiliation Type</legend>
                  <div class="grid grid-cols-2 gap-2 text-sm">
                    <label class="carte-check"><input type="checkbox" name="affiliation" value="Undergraduate" /> Undergraduate</label>
                    <label class="carte-check"><input type="checkbox" name="affiliation" value="Graduate Student" /> Graduate Student</label>
                    <label class="carte-check"><input type="checkbox" name="affiliation" value="Postdoc" /> Postdoc</label>
                    <label class="carte-check"><input type="checkbox" name="affiliation" value="Faculty" /> Faculty</label>
                    <label class="carte-check"><input type="checkbox" name="affiliation" value="Librarian" /> Librarian</label>
                    <label class="carte-check"><input type="checkbox" name="affiliation" value="UofT Staff" /> UofT Staff</label>
                    <label class="carte-check"><input type="checkbox" name="affiliation" value="Alumni" /> Alumni</label>
                    <label class="carte-check"><input type="checkbox" name="affiliation" value="External Partner" /> External Partner</label>
                  </div>
                </fieldset>

                <p id="contact-subscribe-status" class="hidden text-sm"></p>

                <button
                  type="submit"
                  id="contact-subscribe-btn"
                  class="carte-btn-primary w-full disabled:opacity-60 disabled:cursor-not-allowed"
                >
                  Subscribe
                </button>
              </form>
            </div>
          </details>
        </div>
        
      </div>
    </div>
  </section>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-subscribe-form') as HTMLFormElement | null;
    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('contact-subscribe-btn') as HTMLButtonElement;
      const status = document.getElementById('contact-subscribe-status') as HTMLParagraphElement;

      btn.disabled = true;
      btn.textContent = 'Subscribing…';
      status.className = 'hidden text-sm';

      const data = new FormData(form);
      const affiliationTypes = [...form.querySelectorAll<HTMLInputElement>('input[name="affiliation"]:checked')]
        .map(el => el.value);

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: data.get('email'),
            firstName: data.get('first_name'),
            lastName: data.get('last_name'),
            organization: data.get('organization'),
            academicUnit: data.get('academic_unit'),
            affiliationTypes,
          }),
        });

        if (res.ok) {
          form.innerHTML = '<p class="text-sm font-medium py-2" style="color:var(--color-success)">You\'re subscribed. Thank you.</p>';
        } else {
          throw new Error('subscribe failed');
        }
      } catch {
        status.textContent = 'Something went wrong. Please try again or email us at carte@utoronto.ca';
        status.className = 'text-sm'; status.style.color = 'var(--color-danger)';
        btn.disabled = false;
        btn.textContent = 'Subscribe';
      }
    });
  }

  setupContactForm();
</script>

</BaseLayout>
