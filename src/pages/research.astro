---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { getCollection } from 'astro:content';

// Fetch all research papers from content collection
const allResearch = await getCollection('research');

// Split into featured and secondary, sorted by order
const featuredResearch = allResearch
  .filter(paper => paper.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const secondaryResearch = allResearch
  .filter(paper => !paper.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Research" description="Carte-supported research publications spanning computer vision, healthcare AI, sustainability, and more.">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24">
      <div class="max-w-3xl">
        <h1 class="carte-h1 mb-6">
          Applied AI research<br/>
          that translates
        </h1>
        <p class="text-xl text-muted leading-relaxed">
          Carte supports collaborative research designed for real-world impact — bridging AI with civil engineering, healthcare, sustainability, and beyond. We help partners navigate funding and connect with faculty who can solve their specific challenges.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Research Section (Static Grid) -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="carte-h2 mb-4">Featured publications</h2>
        <p class="text-lg text-muted max-w-2xl mx-auto">Carte-supported research solving real engineering challenges — from building science to healthcare to sustainability.</p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredResearch.map((paper) => (
          <article class="carte-card card-demo">
            <div class="flex flex-wrap gap-2 mb-3">
              {paper.data.tags && paper.data.tags.map(tag => (
                <span class="carte-badge">{tag}</span>
              ))}
            </div>
            <h3>{paper.data.title}</h3>
            {paper.data.description && <p>{paper.data.description}</p>}
            {paper.data.link && <a href={paper.data.link} class="link-arrow">Read the paper →</a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Research Portfolio Carousel Section -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between mb-12">
        <div>
          <h2 class="carte-h2 mb-4">Research portfolio</h2>
          <p class="text-lg text-muted max-w-2xl">Collaborative research across 8 engineering departments — with a focus on practical applications and real-world impact.</p>
        </div>
        <!-- Carousel Navigation -->
        <div class="flex items-center gap-3 mt-6 sm:mt-0">
          <span class="text-sm text-subtle mr-2">{secondaryResearch.length} publications</span>
          <button 
            id="carousel-prev" 
            class="w-10 h-10 rounded-full bg-white border border-slate-200 flex items-center justify-center hover:bg-info hover:border-secondary-blue transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
            aria-label="Previous"
          >
            <svg class="w-5 h-5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>
          <button 
            id="carousel-next" 
            class="w-10 h-10 rounded-full bg-white border border-slate-200 flex items-center justify-center hover:bg-info hover:border-secondary-blue transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
            aria-label="Next"
          >
            <svg class="w-5 h-5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>
      
      <!-- Carousel Container -->
      <div class="relative -mx-4 px-4">
        <div 
          id="portfolio-carousel"
          class="hide-scrollbar flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-4 -mb-4"
        >
          {secondaryResearch.map((paper) => (
            <article class="carte-card card-demo flex-shrink-0 w-[320px] snap-start">
              <!-- Icon -->
              <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4" style="background:var(--surface-sunken)">
                {paper.data.icon === "database" && (
                  <svg class="w-6 h-6" style="color:var(--brand-primary)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>
                  </svg>
                )}
                {paper.data.icon === "health" && (
                  <svg class="w-6 h-6" style="color:var(--brand-primary)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                  </svg>
                )}
                {paper.data.icon === "air" && (
                  <svg class="w-6 h-6" style="color:var(--brand-primary)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
                  </svg>
                )}
                {paper.data.icon === "code" && (
                  <svg class="w-6 h-6" style="color:var(--brand-primary)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                  </svg>
                )}
                {paper.data.icon === "chart" && (
                  <svg class="w-6 h-6" style="color:var(--brand-primary)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                  </svg>
                )}
                {paper.data.icon === "globe" && (
                  <svg class="w-6 h-6" style="color:var(--brand-primary)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                )}
                {paper.data.icon === "houses" && (
                  <svg class="w-6 h-6" style="color:var(--brand-primary)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                  </svg>
                )}
                {paper.data.icon === "people" && (
                  <svg class="w-6 h-6" style="color:var(--brand-primary)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                  </svg>
                )}
              </div>

              <!-- Tags -->
              <div class="flex flex-wrap gap-2 mb-3">
                {paper.data.tags.map(tag => (
                  <span class="carte-badge">{tag}</span>
                ))}
              </div>

              <h3>{paper.data.title}</h3>

              {paper.data.description && <p>{paper.data.description}</p>}
            </article>
          ))}
        </div>
        
        <!-- Fade edges -->
        <div class="absolute left-0 top-0 bottom-4 w-8 bg-gradient-to-r from-(--surface-page) to-transparent pointer-events-none"></div>
        <div class="absolute right-0 top-0 bottom-4 w-8 bg-gradient-to-l from-(--surface-page) to-transparent pointer-events-none"></div>
      </div>
    </div>
  </section>

  <script>
    const carousel = document.getElementById('portfolio-carousel');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    const cardWidth = 320 + 24; // card width + gap
    
    function updateButtons() {
      if (prevBtn && nextBtn && carousel) {
        prevBtn.disabled = carousel.scrollLeft <= 0;
        nextBtn.disabled = carousel.scrollLeft >= carousel.scrollWidth - carousel.clientWidth - 10;
      }
    }
    
    prevBtn?.addEventListener('click', () => {
      carousel?.scrollBy({ left: -cardWidth, behavior: 'smooth' });
    });
    
    nextBtn?.addEventListener('click', () => {
      carousel?.scrollBy({ left: cardWidth, behavior: 'smooth' });
    });
    
    carousel?.addEventListener('scroll', updateButtons);
    updateButtons();
  </script>

  <!-- CTA Section -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inverse-cta">
        <h3>Collaborate with us</h3>
        <p>Whether you're a faculty member seeking AI expertise, an industry partner looking to sponsor research, or a student interested in applied AI projects—we're here to help.</p>
        <div class="row">
          <a class="inv-btn primary" href="/contact">Get in touch</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

