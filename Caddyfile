# Redirect www to non-www (canonical URL)
www.carte.utoronto.ca {
    redir https://carte.utoronto.ca{uri} permanent
}

# Main site
carte.utoronto.ca {
    # Proxy /beta to the beta service
    redir /beta /beta/
    handle_path /beta/* {
        reverse_proxy beta:80
    }

    # Redirect US spelling to Canadian spelling
    @us_spelling path_regexp us_spelling ^/neighborhoods(/.*)?$
    redir @us_spelling /neighbourhoods{re.us_spelling.1} permanent

    # Proxy /neighbourhoods to the toronto-neighbourhoods service
    redir /neighbourhoods /neighbourhoods/
    handle_path /neighbourhoods/* {
        reverse_proxy neighbourhoods:80
    }

    handle /api/subscribe {
        reverse_proxy subscribe-api:3000
    }

    # Main site
    handle {
        root * /srv
        file_server

        # Immutable cache for Astro assets (hashed filenames)
        @astro path /_astro/*
        header @astro Cache-Control "public, max-age=31536000, immutable"

        try_files {path} {path}/ {path}/index.html {path}.html
    }

    # Security headers (gloasbal)
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Handle 404s gracefully
    handle_errors {
        respond "{err.status_code} {err.status_text}"
    }
}

# Fallback for direct IP access or other hostnames (optional, for testing)
:80 {
    redir https://carte.utoronto.ca{uri} permanent
}
